# Neon pooled connection for HTTP API (keep sslmode / channel_binding parameters).
DATABASE_URL=
# Neon direct (non-pooler) connection for Alembic; no runtime DDL privileges needed.
MIGRATION_DATABASE_URL=
# Development-only API gate. Generate a random value of at least 32 characters.
# Leave blank to disable all business API access. Never put it in a frontend build.
PLATFORM_API_KEY=
PLATFORM_WORKSPACE_SLUG=development
DB_CONNECT_TIMEOUT=10
# The first FastAPI integration runs a bounded local LangGraph workflow.
# Provider API keys are intentionally not read by the HTTP API in this phase.
AGENT_PROVIDER=local
AGENT_MODEL=deterministic-langgraph
# Comma-separated browser origins permitted to call this API.
FRONTEND_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# Set exactly one provider key only after switching AGENT_PROVIDER from local.
# GOOGLE_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
