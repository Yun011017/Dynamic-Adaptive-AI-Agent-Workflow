# Neon pooled connection for HTTP API (keep sslmode / channel_binding parameters).
DATABASE_URL=
# Neon direct (non-pooler) connection for Alembic; no runtime DDL privileges needed.
MIGRATION_DATABASE_URL=
# Development-only API gate. Generate a random value of at least 32 characters.
# Leave blank to disable all business API access. Never put it in a frontend build.
PLATFORM_API_KEY=
PLATFORM_WORKSPACE_SLUG=development
DB_CONNECT_TIMEOUT=10
# The first FastAPI integration runs a bounded local LangGraph workflow.
# Provider API keys are intentionally not read by the HTTP API in this phase.
AGENT_PROVIDER=local
AGENT_MODEL=deterministic-langgraph
# Comma-separated browser origins permitted to call this API.
FRONTEND_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Meta Instagram publishing. Required only when an approved, scheduled draft
# is actually sent to Meta; proposal creation, review, and scheduling work
# without these values.
META_IG_USER_ID=
META_ACCESS_TOKEN=
GRAPH_API_VERSION=v21.0
# Required only when a scheduled worker refreshes an expiring Meta token.
# Keep these server-side; do not expose them to the frontend.
META_APP_ID=
META_APP_SECRET=
# ISO 8601 expiry of the currently active token, for example:
# 2026-01-15T00:00:00+00:00
META_TOKEN_EXPIRES_AT=
# Required if refreshed tokens are stored encrypted in the database.
TOKEN_ENCRYPTION_KEY=

# Set exactly one provider key only after switching AGENT_PROVIDER from local.
# GOOGLE_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Cloudflare R2 S3 API credentials. The public base URL must be a public custom
# domain (or r2.dev development URL) that both browsers and Meta can read.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=
# Optional: defaults to 100 MB.
R2_MAX_UPLOAD_BYTES=104857600
# If direct R2 upload is unavailable (for example, a missing browser CORS rule),
# files up to this size can safely use the backend fallback.
R2_PROXY_FALLBACK_MAX_BYTES=4194304
# Uploaded files that are never saved into a content proposal are deleted after
# this grace period by the deployed daily cleanup route.
MEDIA_UPLOAD_TTL_HOURS=24
# Used only by Vercel Cron to call /internal/media/cleanup.
CRON_SECRET=

# Form ingestion worker: backend-only deployment URL and stable logical form identity.
GOOGLE_FORMS_APPS_SCRIPT_URL=
GOOGLE_FORMS_SOURCE_ID=connection-test
# Exact sheet question titles for structured answers; missing answers stay NULL.
GOOGLE_FORMS_MEMBER_COLUMN=是否是社員
GOOGLE_FORMS_ATTENDANCE_COLUMN=是否要參加
GOOGLE_FORMS_SCHOOL_COLUMN=學校
GOOGLE_FORMS_DEPARTMENT_GRADE_COLUMN=系級
GOOGLE_FORMS_ACTIVITY_COLUMN=參加的活動
GOOGLE_FORMS_SUBMITTED_AT_COLUMN=時間戳記
